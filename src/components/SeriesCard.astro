---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getSeriesUrl } from "@/utils/getSeries";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";

type Props = {
  entry: CollectionEntry<"series">;
  posts: CollectionEntry<"posts">[];
  variant?: "h2" | "h3";
};

const { entry, posts, variant: Heading = "h3" } = Astro.props;
const { title, description, section } = entry.data;
const locale = Astro.currentLocale ?? config.site.lang;
const latestPost = [...posts].sort(
  (a, b) =>
    new Date(b.data.modDatetime ?? b.data.pubDatetime).getTime() -
    new Date(a.data.modDatetime ?? a.data.pubDatetime).getTime()
)[0];
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
const sectionDetails =
  section === "projects"
    ? { label: "Project", path: "projects" }
    : section === "greyhats"
      ? { label: "Grey Hats", path: "greyhats" }
      : undefined;
---

<li
  class="group border-border relative -mx-3 border-b px-3 py-5 last:border-b-0"
>
  <a
    href={getSeriesUrl(entry.id, locale)}
    class:list={[
      "text-accent inline-block text-lg font-semibold after:absolute after:inset-0 after:content-['']",
      "underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading>{title}</Heading>
  </a>

  <div class="mt-2 flex flex-wrap items-center gap-2">
    {
      latestPost && (
        <Datetime
          pubDatetime={latestPost.data.pubDatetime}
          modDatetime={latestPost.data.modDatetime}
          timezone={latestPost.data.timezone}
          showIcon={false}
        />
      )
    }
    <span class="text-muted-foreground text-xs">
      {posts.length}
      {posts.length === 1 ? "post" : "posts"}
    </span>
  </div>

  <p class="mt-2">{description}</p>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    {
      sectionDetails && (
        <a
          href={getRelativeLocaleUrl(locale, sectionDetails.path)}
          class="meta-chip section-chip relative z-10 transition-colors"
        >
          {sectionDetails.label}
        </a>
      )
    }
    {
      tags.length > 0 && (
        <ul class="relative z-10 flex flex-wrap gap-1.5">
          {tags.map(tagName => (
            <Tag tag={slugifyStr(tagName)} {tagName} size="sm" />
          ))}
        </ul>
      )
    }
  </div>
</li>
