---
import { getEntry, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSeriesUrl } from "@/utils/getSeries";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import config from "@/config";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";

type Props = {
  variant?: "h2" | "h3";
  showDescription?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  showDescription = false,
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, section, series, tags, ...datetimeProps } = data;
const locale = Astro.currentLocale ?? config.site.lang;
const seriesEntry = series ? await getEntry("series", series) : undefined;

const sectionDetails = {
  general: undefined,
  projects: { label: "Project", path: "projects" },
  greyhats: { label: "Grey Hats", path: "greyhats" },
}[section];
---

<li
  class="group border-border relative -mx-3 border-b px-3 py-5 last:border-b-0"
>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "text-accent inline-block text-lg font-semibold after:absolute after:inset-0 after:content-['']",
      "underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading transition:name={toTransitionName(id)}>
      {title}
    </Heading>
  </a>

  <Datetime class="mt-2" showIcon={false} {...datetimeProps} />

  {showDescription && <p class="mt-2">{description}</p>}

  <div class="mt-3 flex flex-wrap items-center gap-2">
    {
      series && (
        <a
          href={getSeriesUrl(series, locale)}
          class="meta-chip series-chip relative z-10 transition-colors"
        >
          Series: {seriesEntry?.data.title ?? series}
        </a>
      )
    }
    {
      sectionDetails && (
        <a
          href={getRelativeLocaleUrl(locale, sectionDetails.path)}
          class="meta-chip section-chip relative z-10 transition-colors"
        >
          {sectionDetails.label}
        </a>
      )
    }
    {
      tags.length > 0 && (
        <ul class="relative z-10 flex flex-wrap gap-1.5">
          {tags.map(tagName => (
            <Tag tag={slugifyStr(tagName)} {tagName} size="sm" />
          ))}
        </ul>
      )
    }
  </div>
</li>
