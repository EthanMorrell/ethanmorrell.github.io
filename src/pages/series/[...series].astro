---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import { getSeriesPosts } from "@/utils/getSeries";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const seriesEntries = await getCollection("series");
  const posts = await getCollection("posts");

  return seriesEntries.map(entry => ({
    params: { series: entry.id },
    props: {
      entry,
      posts: getSeriesPosts(posts, entry.id),
    },
  }));
}

type Props = {
  entry: CollectionEntry<"series">;
  posts: CollectionEntry<"posts">[];
};

const { entry, posts } = Astro.props;
const { title, description, section } = entry.data;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const sectionTitle =
  section === "projects"
    ? t.pages.projectsTitle
    : section === "greyhats"
      ? t.pages.greyhatsTitle
      : undefined;
const sectionUrl = section ? getRelativeLocaleUrl(locale, section) : undefined;
---

<Layout title={`${title} | ${config.site.title}`} {description}>
  <Header />

  <Main pageTitle={title} pageDesc={description}>
    <div
      class="text-muted-foreground mb-8 flex flex-wrap items-center gap-2 text-sm"
    >
      {
        sectionTitle && sectionUrl && (
          <>
            <a
              href={sectionUrl}
              class="text-accent underline-offset-4 hover:underline"
            >
              {sectionTitle}
            </a>
            <span aria-hidden="true">&middot;</span>
          </>
        )
      }
      <span>{posts.length} {posts.length === 1 ? "post" : "posts"}</span>
    </div>

    {
      hasBody && (
        <article class="app-prose max-w-app mb-10 w-full">
          <Content />
        </article>
      )
    }

    <section aria-labelledby="series-posts">
      <h2 id="series-posts" class="text-xl font-semibold sm:text-2xl">
        {t.pages.seriesPostsTitle}
      </h2>
      {
        posts.length > 0 ? (
          <ol>
            {posts.map(post => (
              <Card {...post} />
            ))}
          </ol>
        ) : (
          <p class="mt-4">{t.pages.noSeriesPosts}</p>
        )
      }
    </section>
  </Main>

  <Footer />
</Layout>
