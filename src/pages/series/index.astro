---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import SeriesCard from "@/components/SeriesCard.astro";
import Footer from "@/components/Footer.astro";
import { getSeriesPosts, type SeriesSection } from "@/utils/getSeries";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const seriesEntries = (await getCollection("series")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
const posts = await getCollection("posts");

const groups: { section: SeriesSection | undefined; title: string }[] = [
  { section: "projects", title: t.pages.projectSeriesTitle },
  { section: "club", title: t.pages.clubSeriesTitle },
  { section: undefined, title: t.pages.otherSeriesTitle },
];
---

<Layout
  title={`${t.pages.seriesTitle} | ${config.site.title}`}
  description={t.pages.seriesDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.seriesTitle} pageDesc={t.pages.seriesDesc}>
    {
      seriesEntries.length === 0 ? (
        <p>{t.pages.noSeries}</p>
      ) : (
        <div class="space-y-10">
          {groups.map(({ section, title }) => {
            const entries = seriesEntries.filter(
              ({ data }) => data.section === section
            );

            return (
              entries.length > 0 && (
                <section aria-labelledby={`${section}-series`}>
                  <h2
                    id={`${section}-series`}
                    class="text-xl font-semibold sm:text-2xl"
                  >
                    {title}
                  </h2>
                  <ul>
                    {entries.map(entry => (
                      <SeriesCard
                        {entry}
                        postCount={getSeriesPosts(posts, entry.id).length}
                      />
                    ))}
                  </ul>
                </section>
              )
            );
          })}
        </div>
      )
    }
  </Main>

  <Footer />
</Layout>
