---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { Image } from "astro:assets";
import profile from "@/assets/images/profile.png";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(16rem,2fr)] lg:gap-x-12"
      >
        <div class="lg:col-start-1 lg:row-start-1">
          <div class="flex items-center gap-4">
            <h1 class="my-4 text-4xl font-bold sm:my-8 sm:text-5xl">
              Bozho (Hello)
            </h1>
            <a
              target="_blank"
              href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
              class="inline-block"
              aria-label="RSS Feed"
              title="RSS Feed"
            >
              <IconRss
                width={20}
                height={20}
                class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
              />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>

          <p>Welcome to my InfoSec blog!</p>
          <p class="mt-5">
            My name is Ethan. I am currently pursuing my M.S. in Computer Science at the University of Hawaii at Manoa. I have a strong interest in cybersecurity, which will be the focus of many of my posts.
          </p>
          <p class="mt-5">
            You can learn more about me and this site{" "}
            <LinkButton
              class="hover:text-accent underline underline-offset-4"
              href={getRelativeLocaleUrl(locale, "about")}
            >
              here
            </LinkButton>
            .
          </p>
        </div>

        <div
          class="max-w-80 justify-self-center p-3 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:w-full lg:justify-self-end"
        >
          <Image
            src={profile}
            alt="Ethan Morrell"
            class="h-full w-full rounded-lg object-cover"
            loading="eager"
          />
        </div>

        {
          socials.length > 0 && (
            <div class="flex max-sm:flex-col sm:items-center lg:col-start-1 lg:row-start-2 lg:self-end">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" showDescription {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
